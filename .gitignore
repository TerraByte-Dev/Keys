# Big binaries — never commit these
soundfonts/*
!soundfonts/README.md
midi/*
!midi/README.md
recordings/
*.sf2
*.sf3
*.wav

# Local state
keys.db
# --dev writes this into the data dir, which IS the repo in a source checkout.
keys-dev.log
scores/
*.db-journal
# WAL mode leaves these two beside the database; they are as local as it is.
*.db-wal
*.db-shm
config.local.json

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/

# Build output. dist/ was already here for Node's sake; build/ is PyInstaller's
# scratch directory and Keys.spec's siblings are generated, not authored.
dist/
build/
*.manifest

# Third-party bundles a research pass may drop here while it is sizing renderers.
# Nothing vendored belongs at the repo root -- if a renderer is ever adopted it goes in
# frontend/vendor/ with its licence file beside it, deliberately and reviewed.
/*.js
!keys.js
